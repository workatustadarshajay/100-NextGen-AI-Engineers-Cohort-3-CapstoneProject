# Optional override for a different async SQLAlchemy database URL.
DATABASE_URL=sqlite+aiosqlite:///./data/documents.db
APP_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret

# Optional LangSmith tracing. Keep the API key out of version control.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_TRACING_V2=true
LANGSMITH_PROJECT=my-first-agent
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
# Optional PEM bundle for TLS-inspecting proxies; leave blank on standard networks.

# Required for the clinical agent workflow. Never commit a real key.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional model and retrieval overrides.
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TIMEOUT_SECONDS=90
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=medical_guidelines
GUIDELINES_DIR=data/guidelines
SYNTHETIC_DIR=data/synthetic
RAG_TOP_K=4
RAG_MIN_RELEVANCE_SCORE=0.2
# Optional fallback search over guideline-like records in Europe PMC/PubMed.
TRUSTED_SEARCH_ENABLED=0
TRUSTED_SEARCH_LIMIT=3
TRUSTED_SEARCH_TIMEOUT=8
