# Optional override for a different async SQLAlchemy database URL.
DATABASE_URL=sqlite+aiosqlite:///./data/documents.db

# Required for the clinical agent workflow. Never commit a real key.
GEMINI_API_KEY=

# Optional model and retrieval overrides.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TIMEOUT_SECONDS=90
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=medical_guidelines
GUIDELINES_DIR=data/guidelines
SYNTHETIC_DIR=data/synthetic
RAG_TOP_K=4
